# Node modules at repository root (ignore top-level node_modules)
frontend/react-vtab/node_modules/
frontend/react-vtab/npm_cache/

# Python virtual envs at repository root (ignore top-level venvs)
backend/.venv/
/venv/

# Common virtualenv names
env/
ENV/

# Ignore Python cache and artifacts
__pycache__/
*.pyc

# Ignore npm/yarn lock backups
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Allow node_modules inside frontend/react-vtab (don't ignore)
!frontend/react-vtab/node_modules/

# Allow backend venv to remain tracked if present (negation)
!backend/.venv/

# Editor folders
.vscode/
.idea/

# Secrets
.env
.env.*