# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored — never commit real secrets.

# Google Gemini API key used for conversational field extraction.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model used for extraction.
GEMINI_MODEL=gemini-3.6-flash
